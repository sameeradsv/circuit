# Optional: Postgres. Defaults to SQLite at data/circuit.db
# DATABASE_URL=postgresql://user:password@host/dbname

CORS_ORIGINS=http://localhost:3000,https://sameeradsv.github.io

# AI providers (Chat agent + task classify)
# Groq — recommended; free tier at console.groq.com (same as Conduit)
GROQ_API_KEY=gsk_...
# Optional: force provider (default: Groq if GROQ_API_KEY set, else Anthropic)
# CIRCUIT_AGENT_PROVIDER=groq
# CIRCUIT_AGENT_MODEL=llama-3.3-70b-versatile

# Anthropic — fallback for Chat if Groq is not set
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: Shared Cortex Auth Server — validates cross-app tokens.
# Leave blank for Circuit-only auth.
# CORTEX_AUTH_URL=http://localhost:7000
# CORTEX_AUTH_URL=https://cortex-auth.onrender.com
