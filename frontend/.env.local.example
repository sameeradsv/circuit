# Local dev
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: Shared Cortex Auth Server — enables cross-app accounts (Canopy, Chef, Circuit).
# Leave blank to use Circuit-only local accounts.
NEXT_PUBLIC_CORTEX_URL=http://localhost:7000

# Optional: sibling apps for cross-app energy sync (same Cortex JWT).
NEXT_PUBLIC_CANOPY_API_URL=http://localhost:8002
NEXT_PUBLIC_CHEF_API_URL=http://localhost:8003

# Production
# NEXT_PUBLIC_API_URL=https://circuit-api.onrender.com
# NEXT_PUBLIC_CORTEX_URL=https://cortex-auth.onrender.com
